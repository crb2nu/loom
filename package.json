{
    "name": "loom",
    "displayName": "Loom",
    "description": "Weaving context for AI - Unified MCP hub management for VS Code, Codex, Kilocode, and Claude Code.",
    "version": "0.5.0",
    "publisher": "cblevins",
    "repository": {
        "type": "git",
        "url": "https://gitlab.flexinfer.ai/root/gitops.git"
    },
    "engines": {
        "vscode": "^1.80.0"
    },
    "categories": [
        "Other"
    ],
    "activationEvents": [
        "onStartupFinished"
    ],
    "main": "./out/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "loom.showStatus",
                "title": "Loom: Show Context Status"
            },
            {
                "command": "loom.showSyncStatus",
                "title": "Loom: Show Config Sync Status"
            },
            {
                "command": "loom.showMeshReport",
                "title": "Loom: Show MCP Mesh Report"
            },
            {
                "command": "loom.syncConfigs",
                "title": "Loom: Sync MCP Configs"
            },
            {
                "command": "loom.checkMcpHealth",
                "title": "Loom: Check MCP Server Health"
            },
            {
                "command": "loom.snapshotContext",
                "title": "Loom: Snapshot Context to Qdrant"
            },
            {
                "command": "loom.bootstrapContext",
                "title": "Loom: Bootstrap Workspace Context"
            },
            {
                "command": "loom.refreshHubStatus",
                "title": "Loom: Refresh MCP Hub Status"
            },
            {
                "command": "loom.verifyHubClient",
                "title": "Loom: Verify MCP Hub Client"
            },
            {
                "command": "loom.startDaemon",
                "title": "Loom: Start Daemon"
            },
            {
                "command": "loom.stopDaemon",
                "title": "Loom: Stop Daemon"
            },
            {
                "command": "loom.restartDaemon",
                "title": "Loom: Restart Daemon"
            },
            {
                "command": "loom.daemonStatus",
                "title": "Loom: Show Daemon Status"
            },
            {
                "command": "loom.refreshTools",
                "title": "Loom: Refresh Tools"
            },
            {
                "command": "loom.searchTools",
                "title": "Loom: Search Tools"
            },
            {
                "command": "loom.listSecrets",
                "title": "Loom: List Secrets"
            },
            {
                "command": "loom.setSecret",
                "title": "Loom: Set Secret"
            },
            {
                "command": "loom.importSecrets",
                "title": "Loom: Import Secrets from File"
            },
            {
                "command": "loom.validateSecrets",
                "title": "Loom: Validate Config Secrets"
            },
            {
                "command": "loom.refreshSecrets",
                "title": "Loom: Refresh Secrets Cache"
            }
        ],
        "views": {
            "explorer": [
                {
                    "id": "loomHubOverview",
                    "name": "Loom Hub"
                },
                {
                    "id": "loomServers",
                    "name": "Loom Servers"
                },
                {
                    "id": "loomTools",
                    "name": "Loom Tools"
                },
                {
                    "id": "loomSecrets",
                    "name": "Loom Secrets"
                }
            ]
        },
        "configuration": {
            "title": "Loom",
            "properties": {
                "loom.hubUrl": {
                    "type": "string",
                    "default": "wss://mcp.flexinfer.ai/ws",
                    "description": "WebSocket URL for the centralized MCP hub gateway."
                },
                "loom.hubProfile": {
                    "type": "string",
                    "default": "codex",
                    "description": "Profile sent to the MCP hub (codex, kilocode, vscode, etc.)."
                },
                "loom.autoSyncOnDrift": {
                    "type": "string",
                    "enum": [
                        "off",
                        "prompt",
                        "auto"
                    ],
                    "default": "prompt",
                    "description": "Action when config drift is detected. 'off' = ignore, 'prompt' = ask user, 'auto' = sync automatically."
                }
            }
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "package": "vsce package",
        "lint": "eslint src --ext .ts",
        "lint:fix": "eslint src --ext .ts --fix",
        "format": "prettier --write \"src/**/*.ts\"",
        "format:check": "prettier --check \"src/**/*.ts\"",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "check": "npm run lint && npm run format:check && tsc --noEmit"
    },
    "lint-staged": {
        "*.{ts,tsx,js,json,md}": [
            "prettier --write"
        ],
        "src/**/*.{ts,tsx}": [
            "eslint --fix"
        ]
    },
    "devDependencies": {
        "@types/node": "^20.0.0",
        "@types/vscode": "^1.80.0",
        "@typescript-eslint/eslint-plugin": "^8.18.0",
        "@typescript-eslint/parser": "^8.18.0",
        "@vitest/coverage-v8": "^2.1.0",
        "@vscode/vsce": "^3.1.0",
        "eslint": "^8.57.0",
        "eslint-config-prettier": "^9.1.0",
        "eslint-import-resolver-typescript": "^4.4.4",
        "eslint-plugin-import": "^2.31.0",
        "husky": "^9.0.0",
        "lint-staged": "^15.0.0",
        "prettier": "^3.4.2",
        "typescript": "^5.4.0",
        "vitest": "^2.1.0"
    },
    "dependencies": {
        "yaml": "^2.4.2"
    }
}
