{
    "name": "loom",
    "displayName": "Loom - MCP Context Manager",
    "description": "Unified MCP hub management for AI coding assistants. Sync configs across VS Code, Antigravity, Codex, Claude, Kilocode, and Gemini.",
    "version": "0.9.0",
    "publisher": "cblevins",
    "license": "MIT",
    "icon": "assets/icon.png",
    "galleryBanner": {
        "color": "#1a1a2e",
        "theme": "dark"
    },
    "repository": {
        "type": "git",
        "url": "https://gitlab.flexinfer.ai/services/loom.git"
    },
    "homepage": "https://gitlab.flexinfer.ai/services/loom",
    "bugs": {
        "url": "https://gitlab.flexinfer.ai/services/loom/-/issues"
    },
    "keywords": [
        "mcp",
        "model-context-protocol",
        "ai",
        "coding-assistant",
        "claude",
        "codex",
        "gemini",
        "context-management",
        "sync"
    ],
    "engines": {
        "vscode": "^1.80.0"
    },
    "categories": [
        "Machine Learning",
        "Other"
    ],
    "activationEvents": [
        "onStartupFinished"
    ],
    "main": "./out/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "loom.showStatus",
